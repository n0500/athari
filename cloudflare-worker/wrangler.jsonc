{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "athari-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "ai": { "binding": "AI" },
  "vars": {
    "FIREBASE_PROJECT_ID": "REPLACE_WITH_FIREBASE_PROJECT_ID",
    "ALLOWED_ORIGINS": "https://REPLACE_WITH_FIREBASE_HOSTING_DOMAIN"
  }
}
